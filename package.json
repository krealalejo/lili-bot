{
  "name": "lilibot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord rotation bot for a 5-slot game group, running as HTTP interactions on Cloud Run",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "start": "node src/index.ts",
    "commands": "node --env-file=.env src/deploy-commands.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
